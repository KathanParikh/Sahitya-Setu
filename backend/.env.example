# Copy to backend/.env and fill in. Never commit the real .env.

# --- LLM -------------------------------------------------------------------
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Get a free key at https://console.groq.com/keys  (backup provider)
GROQ_API_KEY=

# "gemini" or "groq" — the single switch that changes provider system-wide.
SS_LLM_PROVIDER=gemini

# Current stable Flash models: gemini-3.8-flash, gemini-3.6-flash.
# gemini-1.5-flash and gemini-2.0-flash have been shut down.
SS_GEMINI_MODEL=gemini-3.8-flash
# Groq production model used for the QA evaluation.
SS_GROQ_MODEL=openai/gpt-oss-120b

# --- database --------------------------------------------------------------
# Supabase dashboard > Connect > Session pooler. Keep the password out of git.
SS_DATABASE_URL=
# Supabase dashboard > Project Settings > API Keys > secret key. Server only, never
# in frontend code.
SS_SUPABASE_SECRET=

# --- optional overrides ----------------------------------------------------
# SS_CHUNK_SIZE=400
# SS_CHUNK_OVERLAP=50
# SS_FINAL_TOP_K=5
# SS_MAX_QUERY_REWRITES=2
# SS_SUMMARY_LANGUAGE=gujarati
# SS_TESSERACT_CMD=/opt/homebrew/bin/tesseract
# SS_POPPLER_PATH=/opt/homebrew/bin
# SS_ASKS_PER_HOUR=20
# SS_SUMMARIES_PER_HOUR=5
# SS_UPLOADS_PER_HOUR=5
# SS_ALLOW_LIVE_EVALUATION=false
# Comma-separated allowed origins. Use * to allow any origin in development.
# SS_CORS_ORIGINS=http://localhost:5173
