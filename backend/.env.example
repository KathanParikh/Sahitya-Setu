# Copy to backend/.env and fill in. Never commit the real .env.

# --- LLM -------------------------------------------------------------------
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Get a free key at https://console.groq.com/keys  (backup provider)
GROQ_API_KEY=

# "gemini" or "groq" — the single switch that changes provider system-wide.
SS_LLM_PROVIDER=gemini

# Free-tier friendly Gemini models: gemini-2.0-flash, gemini-2.5-flash.
# gemini-1.5-flash is no longer available on API keys created after mid-2025.
SS_GEMINI_MODEL=gemini-2.0-flash
SS_GROQ_MODEL=llama-3.3-70b-versatile

# --- optional overrides ----------------------------------------------------
# SS_CHUNK_SIZE=400
# SS_CHUNK_OVERLAP=50
# SS_FINAL_TOP_K=5
# SS_MAX_QUERY_REWRITES=2
# SS_SUMMARY_LANGUAGE=gujarati
# SS_TESSERACT_CMD=/opt/homebrew/bin/tesseract
# SS_POPPLER_PATH=/opt/homebrew/bin
# Comma-separated allowed origins. Use * to allow any origin in development.
# SS_CORS_ORIGINS=http://localhost:5173
